{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Streamloop",
  "description": "Live stream pre-recorded video in HDR at up to 4K 60fps, collaborate with multi-user team access, and run 24/7 without OBS or a PC.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "seo": {
    "metatags": {
      "canonical": "https://streamloop.app/docs",
      "google-site-verification": "boTPQBp0fR64j1H5dh1GQjKRbK94Upm8SbsCRUu12t0"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "api": {
    "openapi": "https://api.streamloop.app/v1/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "python", "javascript"]
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "https://streamloop.app"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "quickstart",
              "features",
              "billing",
              "account-access",
              "reliability-guarantees"
            ]
          },
          {
            "group": "Your first stream",
            "icon": "video",
            "expanded": true,
            "pages": [
              "build-and-schedule-your-playlist",
              "custom-playlist-order"
            ]
          },
          {
            "group": "Guides",
            "icon": "lightbulb",
            "expanded": true,
            "pages": [
              "lofi-music-channel"
            ]
          },
          {
            "group": "Destinations",
            "icon": "radio",
            "expanded": true,
            "pages": [
              "platform/youtube",
              "platform/youtube-rtmp"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/conventions",
              "api-reference/quickstart"
            ]
          },
          {
            "group": "REST API",
            "icon": "code",
            "openapi": "https://api.streamloop.app/v1/openapi.json"
          },
          {
            "group": "MCP server",
            "icon": "bot",
            "expanded": true,
            "pages": [
              "api-reference/mcp/overview",
              "api-reference/mcp/tools"
            ]
          },
          {
            "group": "GraphQL API",
            "icon": "braces",
            "pages": [
              "api-reference/graphql"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/Group36.svg",
    "dark": "/images/logo-full-width-s7Ak8428.svg",
    "href": "https://streamloop.app"
  },
  "navbar": {
    "links": [
      {
        "href": "https://streamloop.app/#pricing",
        "label": "Pricing"
      },
      {
        "href": "https://streamloop.app/blog",
        "label": "Blog"
      },
      {
        "href": "https://streamloop.app/auth/login",
        "label": "Sign in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://streamloop.app/loops"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/streamloopapp",
      "linkedin": "https://linkedin.com/company/streamloop",
      "github": "https://github.com/streamloop"
    }
  },
  "fonts": {
    "family": "Hanken Grotesk"
  },
  "background": {
    "color": {
      "dark": "#0D0D0E"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
