{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Streamloop",
  "description": "Run pre-recorded video as a 24/7 live stream at up to 4K 60fps with HDR, send one loop to up to 5 platforms, design live shows with Scenes (beta), and work as a team, with no OBS or PC.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "seo": {
    "metatags": {
      "canonical": "https://streamloop.app/docs",
      "google-site-verification": "boTPQBp0fR64j1H5dh1GQjKRbK94Upm8SbsCRUu12t0"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "api": {
    "openapi": "https://api.streamloop.app/v1/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "python", "javascript"]
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "https://streamloop.app"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "index",
              "quickstart",
              "features",
              "billing",
              "reliability-guarantees"
            ]
          },
          {
            "group": "Video loops",
            "icon": "video",
            "expanded": true,
            "pages": [
              "build-and-schedule-your-playlist",
              "smart-order",
              "library",
              "lofi-music-channel"
            ]
          },
          {
            "group": "Scenes (beta)",
            "icon": "layers",
            "expanded": true,
            "pages": [
              "scenes/overview",
              "scenes/build-a-scene",
              "scenes/live-inputs",
              "scenes/cameras",
              "scenes/web-pages",
              "scenes/data-and-sheets",
              "scenes/ai-assistant",
              "scenes/show-control"
            ]
          },
          {
            "group": "Destinations",
            "icon": "radio",
            "expanded": true,
            "pages": [
              "platform/multistream",
              "platform/youtube",
              "platform/youtube-rtmp",
              "platform/twitch",
              "platform/other-rtmp"
            ]
          },
          {
            "group": "Account & team",
            "icon": "users",
            "expanded": true,
            "pages": [
              "workspaces-and-team",
              "account-access",
              "use-with-ai"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/conventions",
              "api-reference/quickstart"
            ]
          },
          {
            "group": "REST API",
            "icon": "code",
            "openapi": "https://api.streamloop.app/v1/openapi.json"
          },
          {
            "group": "Scenes API",
            "icon": "layers",
            "pages": [
              "api-reference/scenes",
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "api-reference/scenes-openapi.json",
                  "directory": "api-reference/scenes-api"
                }
              }
            ]
          },
          {
            "group": "MCP server",
            "icon": "bot",
            "expanded": true,
            "pages": [
              "api-reference/mcp/overview",
              "api-reference/mcp/tools"
            ]
          },
          {
            "group": "GraphQL API",
            "icon": "braces",
            "pages": [
              "api-reference/graphql"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/custom-playlist-order",
      "destination": "/smart-order"
    }
  ],
  "logo": {
    "light": "/images/Group36.svg",
    "dark": "/images/logo-full-width-s7Ak8428.svg",
    "href": "https://streamloop.app"
  },
  "navbar": {
    "links": [
      {
        "href": "https://streamloop.app/#pricing",
        "label": "Pricing"
      },
      {
        "href": "https://streamloop.app/blog",
        "label": "Blog"
      },
      {
        "href": "https://streamloop.app/auth/login",
        "label": "Sign in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://streamloop.app/loops"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/streamloopapp",
      "linkedin": "https://linkedin.com/company/streamloop",
      "github": "https://github.com/streamloop"
    }
  },
  "fonts": {
    "family": "Hanken Grotesk"
  },
  "background": {
    "color": {
      "dark": "#0D0D0E"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
