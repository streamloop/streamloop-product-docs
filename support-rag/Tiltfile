docker_compose("docker-compose.yml")

local_resource(
    "sync-llms",
    "npm run llms",
    deps=["../llms.txt"],
)

local_resource(
    "build-local-index",
    "npm run index",
    deps=["../llms.txt", "../docs.json"],
)

