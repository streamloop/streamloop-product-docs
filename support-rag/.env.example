OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MAX_TOKENS=700
OPENROUTER_SITE_URL=https://docs.streamloop.app
OPENROUTER_APP_NAME=Streamloop Support RAG

DOCS_ROOT=..
DOCS_BASE_URL=https://streamloop.app/docs
LLMS_SOURCE_URL=https://streamloop.app/llms.txt
INDEX_PATH=./data/index.json
PORT=8787
RAG_BACKEND=r2r
ALLOW_LOCAL_FALLBACK=true

R2R_BASE_URL=http://localhost:7272
R2R_API_KEY=
R2R_PROJECT_NAME=streamloop_support
R2R_SEARCH_MODE=advanced
R2R_SEARCH_LIMIT=8
R2R_REQUEST_RETRIES=3
R2R_REQUEST_RETRY_MS=2500

# Local fallback only. Production retrieval is R2R.
EMBEDDING_PROVIDER=hash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=snowflake-arctic-embed-l-v2.0

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres
OTEL_SERVICE_NAME=streamloop-support-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

DRY_RUN=true
