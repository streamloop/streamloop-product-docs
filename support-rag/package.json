{
  "name": "streamloop-support-rag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "index": "tsx src/scripts/build-index.ts",
    "ingest:r2r": "tsx src/scripts/ingest-r2r.ts",
    "llms": "tsx src/scripts/generate-llms.ts",
