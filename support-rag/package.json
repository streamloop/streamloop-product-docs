    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "pg": "^8.21.0",
    "r2r-js": "^0.4.43",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@inkeep/agents-sdk": "0.73.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
